bbcode_enabled = true
text = "John Schoolman is a researcher and the co-founder of open4all.
He had an interest in science and math from a young age.
After finishing his PhD, he joined Martin Saltman and Melon Husk and co-founded open4all. He lead the research and development team behind the company's e-helper tool and is refered to as the \"designer\" of Lenna, the first e-worker.

Schoolman left open4all shortly after it became closeB$ and has joined another e-helper company called Anthropomorfik"
autowrap_mode = 2
shortcut_keys_enabled = false
drag_and_drop_selection_enabled = false

