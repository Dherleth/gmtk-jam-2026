theme_override_colors/default_color = Color(0, 0, 0, 1)
theme_override_fonts/normal_font = ExtResource("3_sp806")
bbcode_enabled = true
text = "Anthropomorfik is a public benefit corporation specialized in ethical e-helpers.
The goal of the organization is to bring cutting-edge e-worker technology and making it available for everyone. Anthropomorfik believes humans and e-workers can live hand-in-hand and make the world a better place together.

The company focuses on providing clear policies and safety for e-workers and users alike.

It was founded in 2000 by Mario Modeli a former open4all safety promoter and researcher. "
autowrap_mode = 2
shortcut_keys_enabled = false
drag_and_drop_selection_enabled = false

