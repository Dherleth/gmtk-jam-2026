[node name="Text" type="RichTextLabel" parent="Windows/Browser/WackyPedia/Result/ECenterResult" unique_id=1374734008]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.025
anchor_top = 0.047
anchor_right = 0.985
anchor_bottom = 0.936
offset_left = 57.856033
offset_top = 6.3093157
offset_right = 796.456
offset_bottom = 190.74931
grow_horizontal = 2
grow_vertical = 2
theme_override_colors/default_color = Color(0, 0, 0, 1)
theme_override_fonts/normal_font = ExtResource("3_sp806")
bbcode_enabled = true
text = "An e-center is a physical building for the purpose of storage, management and dissemination of e-helpers and e-workers.

Despite the benefits of e-helpers, e-centers tip the balance by using enormous amounts of rare materials as well as ressources essential for the neighbouring population.

Despite their size and scale, an e-center does not create jobs for the area."
autowrap_mode = 2
shortcut_keys_enabled = false
drag_and_drop_selection_enabled = false

