[node name="Text" type="RichTextLabel" parent="Windows/Browser/WackyPedia/Result/EHelperResult" unique_id=465032562]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.025
anchor_top = 0.047
anchor_right = 0.985
anchor_bottom = 0.936
offset_left = 57.856033
offset_top = 6.3093157
offset_right = 796.456
offset_bottom = 190.74931
grow_horizontal = 2
grow_vertical = 2
theme_override_colors/default_color = Color(0, 0, 0, 1)
theme_override_fonts/normal_font = ExtResource("3_sp806")
bbcode_enabled = true
text = "E-helper is a technology developed using a colossal amount of electronic data and created for the purpose of helping humans, hence the name e-helper (short for electronic helper).

An e-helper is able to perform human tasks such as learning, reasoning and decision-making.
They are capable of speaking in a natural language and understanding given assignments.

Their are resource gorgers and need rare electronic materials as well as a high flow of electricity to power their e-networks and make them useful. Many e-centers have been built to provide enough e-helpers for everyone and keep them up to date."
autowrap_mode = 2
shortcut_keys_enabled = false
drag_and_drop_selection_enabled = false

